# ── Velocidad configuration ────────────────────────────────────────────────

# libSQL database: local file or remote Turso
#   file:./velocidad.db                      → local
#   libsql://velocidad-<org>.turso.io        → Turso (needs TURSO_AUTH_TOKEN)
DATABASE_URL=file:./velocidad.db
# TURSO_AUTH_TOKEN=

# Telegram bot token from @BotFather (required)
TELOXIDE_TOKEN=

# HTTP API port
API_PORT=8080

# PAPER_TRADING=true  → simulated fills against live market prices
# PAPER_TRADING=false → real on-chain swaps (requires ZEROEX_API_KEY + a
#                       wallet with an imported private key)
PAPER_TRADING=true

# LIVE_MARKET=true  → prices/liquidity from DexScreener (offline fallback)
# LIVE_MARKET=false → fully deterministic simulator
LIVE_MARKET=true

# Default EVM chain for chain-less commands: ethereum | bsc | polygon |
# arbitrum | optimism | base | avalanche | fantom | linea | blast | scroll | gnosis
DEFAULT_CHAIN=ethereum

# 0x Swap API v2 key — enables live swaps (https://0x.org/).
# Free tier available; leave empty for paper trading.
ZEROEX_API_KEY=

# Optional honeypot.is API key — adds live honeypot simulations to /scan
HONEYPOT_API_KEY=

# Master key used to encrypt wallet private keys (64 hex chars).
# If empty, a key is generated and persisted to ./velocidad.key — keep it safe!
# MASTER_KEY=
