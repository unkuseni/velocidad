# --- Database -----------------------------------------------------------------
# Local libSQL file (default)
DATABASE_URL=file:./velocidad.db

# OR remote Turso (create one with:  turso db create velocidad  then  turso db show velocidad)
# DATABASE_URL=libsql://velocidad-<org>.turso.io
# TURSO_AUTH_TOKEN=eyJ...

# --- Telegram -----------------------------------------------------------------
# Token from @BotFather
TELOXIDE_TOKEN=

# --- API ----------------------------------------------------------------------
API_PORT=8080

# --- Trading ------------------------------------------------------------------
# true = simulated fills against a mock market (no RPC required)
PAPER_TRADING=true

# --- Security -----------------------------------------------------------------
# 64-hex-char AES-256 key used to encrypt wallet private keys.
# If omitted a random key is generated and stored in ./velocidad.key
# MASTER_KEY=
